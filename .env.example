# terminschleuder-extractor configuration.
# Copy to .env and fill in. Every var has the prefix EXTRACTOR_ and is read by
# pydantic-settings. The OpenAI-compatible LLM endpoint is configured here too.
# No ANTHROPIC_API_KEY is used — the extractor talks to any OpenAI-compatible API.

# --- Ingestion API (the terminschleuder backend) ---
# Base URL of the backend. Default points at the production host.
EXTRACTOR_API_BASE_URL=https://www.terminschleuder.online
# Long-lived API key for the ingestion service account. REQUIRED for real runs.
# Sent as: Authorization: Api-Key <raw-key>
EXTRACTOR_API_KEY=

# --- Runner cadence (two independent knobs) ---
# How often the runner wakes up and asks the backend for due sources. Default: 1h.
EXTRACTOR_POLL_INTERVAL_SECONDS=3600
# "loop" (default) keeps running cycles; "once" runs a single cycle and exits.
EXTRACTOR_RUN_MODE=loop
# Per-source politeness floor: never crawl the same source more often than this,
# even if the backend reports it due and the cycle is shorter. Default: 1h.
# A 5-minute cycle with this at 3600 still crawls each site at most once per hour.
EXTRACTOR_MIN_SOURCE_INTERVAL_SECONDS=3600
# Optional file to persist last-crawled timestamps across restarts (empty = in-memory).
EXTRACTOR_STATE_FILE=
# Cap on sources processed per cycle.
EXTRACTOR_MAX_SOURCES_PER_CYCLE=20

# --- HTTP ---
EXTRACTOR_HTTP_TIMEOUT_SECONDS=30
EXTRACTOR_USER_AGENT=terminschleuder-extractor/0.1
EXTRACTOR_MAX_PAGE_CHARS=20000

# --- OpenAI-compatible LLM endpoint (Ollama, vLLM, LM Studio, OpenAI, OpenRouter, ...) ---
# Default targets a local Ollama. From a container reaching host Ollama use
# http://host.docker.internal:11434/v1 (Linux: add --add-host=host.docker.internal:host-gateway).
EXTRACTOR_LLM_BASE_URL=http://localhost:11434/v1
# Ollama ignores this value but the SDK requires a non-empty string; real providers need the real key.
EXTRACTOR_LLM_API_KEY=ollama
# Model served by the provider. Set to whatever your endpoint serves, e.g. qwen2.5, gpt-4o-mini.
EXTRACTOR_LLM_MODEL=llama3.1
EXTRACTOR_LLM_MAX_TOKENS=4096
EXTRACTOR_LLM_TEMPERATURE=0.0

# --- Logging ---
EXTRACTOR_LOG_LEVEL=INFO
EXTRACTOR_LOG_FORMAT=console